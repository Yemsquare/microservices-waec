# Copy to .env and replace all placeholders with strong unique values.
# Never commit .env to Git.

# SQL Server administrator password (SQL Server requires a strong password)
MSSQL_SA_PASSWORD=Replace_With_A_Strong_SQL_Server_Password_2026!

# JWT signing secret: use a cryptographically random value of at least 32 bytes.
# AuthService and ExamGateway must use exactly the same key, issuer and audience.
JWT_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES_OF_SECRET_MATERIAL
JWT_ISSUER=Waec.Auth
JWT_AUDIENCE=Waec.Api
JWT_ACCESS_TOKEN_MINUTES=30
JWT_REFRESH_TOKEN_DAYS=7

# Initial administrator account provisioned by AuthService
ADMIN_EMAIL=admin@example.local
ADMIN_PASSWORD=Replace_With_A_Strong_Admin_Password_2026!

# RabbitMQ credentials
RABBITMQ_DEFAULT_USER=waec
RABBITMQ_DEFAULT_PASS=Replace_With_A_Strong_RabbitMQ_Password_2026!
