{
  "Jwt" :{
    "Issuer" : "${JWT_ISSUE}",
    "Audience" : "${JWT_AUDIENCE}",
    "Key" : "${JWT_KEY}"
  },

  "ReverseProxy":{
    "Routes" :{
      "auth-route" :{
        "ClusterId": "auth-cluster",
        "Match":{
          "path": "/api/auth/{**catch-all}"
        }
      },
      "catalog-route" :{
        "ClusterId": "catalog-cluster",
        "Match":{
          "path": "/api/catalog/{**catch-all}"
        }, 
        "AuthorizationPolicy" : "Authenticated"
        
      },
      "student-route" :{
        "ClusterId": "student-cluster",
        "Match":{
          "path": "/api/student/{**catch-all}"
        },
        "AuthorizationPolicy" : "Authenticated"
      },
       "registration-route" :{
        "ClusterId": "registration-cluster",
        "Match":{
          "path": "/api/registration/{**catch-all}"
        },
        "AuthorizationPolicy" : "Authenticated"
      },
       "orders-route" :{
        "ClusterId": "orders-cluster",
        "Match":{
          "path": "/api/orders/{**catch-all}"
        },
        "AuthorizationPolicy" : "Authenticated"
      }
    },
    "Clusters" : 
    {
      "auth" : { "Destiations" : {"destination1": {"Address": "http://localhost:8084"}}},
      "catalog" : { "Destiations" : {"destination1": {"Address": "http://localhost:8081"}}},
      "orders" : { "Destiations" : {"destination1": {"Address": "http://localhost:8082"}}},
      "registration" : { "Destiations" : {"destination1": {"Address": "http://localhost:8083"}}},
      "student" : { "Destiations" : {"destination1": {"Address": "http://localhost:8085"}}}
    }
  },
   "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" } }
}


