{
  "Jwt": {
  "Issuer": "",
    "Audience": "",
    "Key": ""
  },
  "ReverseProxy": {
  "Routes": {
    "auth-route": {
      "ClusterId": "auth",
      "Match": {
        "Path": "/api/auth/{**catch-all}"
      }
    },

    "catalog-read-route": {
      "ClusterId": "catalog",
      "AuthorizationPolicy": "CatalogRead",
      "Match": {
        "Path": "/api/catalog/subjects/{**catch-all}",
        "Methods": ["GET"]
      }
    },

    "catalog-write-route": {
      "ClusterId": "catalog",
      "AuthorizationPolicy": "CatalogManage",
      "Match": {
        "Path": "/api/catalog/subjects/{**catch-all}",
        "Methods": ["POST", "PUT", "DELETE"]
      }
    },

    "orders-route": {
      "ClusterId": "orders",
      "AuthorizationPolicy": "Authenticated",
      "Match": {
        "Path": "/api/orders/{**catch-all}"
      }
    },

    "registration-read-route": {
      "ClusterId": "registrations",
      "AuthorizationPolicy": "RegistrationsRead",
      "Match": {
        "Path": "/api/registrations/{**catch-all}",
        "Methods": ["GET"]
      }
    },

    "registration-create-route": {
      "ClusterId": "registrations",
      "AuthorizationPolicy": "RegistrationsCreate",
      "Match": {
        "Path": "/api/registrations/{**catch-all}",
        "Methods": ["POST"]
      }
    },

    "student-create-route": {
      "ClusterId": "students",
      "AuthorizationPolicy": "StudentsCreate",
      "Match": {
        "Path": "/api/students/{**catch-all}",
        "Methods": ["POST"]
      }
    },
    "student-read-route": {
      "ClusterId": "students",
      "AuthorizationPolicy": "Authenticated",
      "Match": {
        "Path": "/api/students/{**catch-all}",
        "Methods": ["GET"]
      }
    },
    "student-update-route":{
      "ClusterId": "students",
      "AuthorizationPolicy": "StudentsManage",
      "Match": {
        "Path": "/api/students/{**catch-all}",
        "Methods": ["PUT", "DELETE"]
      }
    },

    "swagger-auth": {
      "ClusterId": "auth",
      "Order": -10,
      "Match": {
        "Path": "/swagger/auth/{**catch-all}"
      },
      "Transforms": [
        {
          "PathPattern": "/swagger/{**catch-all}"
        }
      ]
    },

    "swagger-students": {
      "ClusterId": "students",
      "Order": -10,
      "Match": {
        "Path": "/swagger/students/{**catch-all}"
      },
      "Transforms": [
        {
          "PathPattern": "/swagger/{**catch-all}"
        }
      ]
    },

    "swagger-registration": {
      "ClusterId": "registrations",
      "Order": -10,
      "Match": {
        "Path": "/swagger/registrations/{**catch-all}"
      },
      "Transforms": [
        {
          "PathPattern": "/swagger/{**catch-all}"
        }
      ]
    },

    "swagger-catalog": {
      "ClusterId": "catalog",
      "Order": -10,
      "Match": {
        "Path": "/swagger/catalog/{**catch-all}"
      },
      "Transforms": [
        {
          "PathPattern": "/swagger/{**catch-all}"
        }
      ]
    },

    "swagger-orders": {
      "ClusterId": "orders",
      "Order": -10,
      "Match": {
        "Path": "/swagger/orders/{**catch-all}"
      },
      "Transforms": [
        {
          "PathPattern": "/swagger/{**catch-all}"
        }
      ]
    }
  },

  "Clusters": {
    "auth": {
      "Destinations": {
        "destination1": {
          "Address": "http://auth:8080/"
        }
      }
    },

    "catalog": {
      "Destinations": {
        "destination1": {
          "Address": "http://catalog:8080/"
        }
      }
    },

    "orders": {
      "Destinations": {
        "destination1": {
          "Address": "http://orders:8080/"
        }
      }
    },

    "registration": {
      "Destinations": {
        "destination1": {
          "Address": "http://registrations:8080/"
        }
      }
    },

    "students": {
      "Destinations": {
        "destination1": {
          "Address": "http://students:8080/"
        }
      }
    }
  }
},
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" } }
}
